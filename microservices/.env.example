# Copy this file to .env (same folder) and fill in the values.
# docker-compose reads .env automatically; .env is not tracked by git.

# Key used to sign and verify the JWT in the access_token cookie
JWT_KEY=
# Google OAuth client (sign-in with Google)
CLIENT_ID=
CLIENT_SECRET=
# Gmail app password of solvio.app@gmail.com (emails to Google users)
APP_PWD=
# PayPal sandbox app (buying credits)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Stripe test secret key (earlier payment flow)
STRIPE_SECRET_KEY=
